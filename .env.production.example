ENV_NAME=production
ENFORCE_PRODUCTION_VALIDATION=true

STREAM_CHUNK_SECONDS_MIN=1.0
STREAM_CHUNK_SECONDS_MAX=2.0
STREAM_MAX_LATENCY_SECONDS=2.0
STREAM_QUEUE_SIZE=32
STREAM_SESSION_TTL_SECONDS=1800

AUTH_ENABLED=true
JWT_REQUIRED=true
JWT_SECRET=replace-with-strong-secret
JWT_ALGORITHM=HS256
API_KEYS_CSV=replace-with-comma-separated-api-keys
REPLAY_TTL_SECONDS=300

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_SIZE_BYTES=12000000
MAX_AUDIO_DURATION_SECONDS=30

DRIFT_WINDOW_SIZE=200
DRIFT_BASELINE_SIZE=200
DRIFT_KL_THRESHOLD=0.25
DRIFT_PSI_THRESHOLD=0.20

CALIBRATION_TEMPERATURE=1.0
CALIBRATION_ARTIFACT_PATH=artifacts/calibration/temperature_scaling.json
CALIBRATION_RECOMPUTE_DAYS=30
